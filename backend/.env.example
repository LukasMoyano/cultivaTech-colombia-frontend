PORT=3001
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LARGO
OPENWEATHER_API_KEY=REEMPLAZAR
ALLOWED_ORIGINS=http://localhost:5173,https://cultivatech-colombia-frontend.netlify.app

# Oráculo / edge
DEVICE_SECRETS={"NODE-CULTIVA-01":"REEMPLAZAR_SECRETO_COMPARTIDO"}
ALLOWED_NODES=NODE-CULTIVA-01
BATCH_SIZE=5
MAX_TS_SKEW_MS=300000
ALLOW_SIMULATION=false
ORACLE_STATE_PATH=./data/oraculo_estado.json

# Telemetría en vivo (SSE)
TELEMETRY_PATH=./data/telemetria.json
TELEMETRY_HISTORY_MAX=240
TELEMETRY_SAVE_DEBOUNCE_MS=2000
TELEMETRY_HEARTBEAT_MS=15000

# Web3 (Sepolia). Sin RPC_URL/PRIVATE_KEY/CONTRACT_ADDRESS el oráculo queda en simulación.
RPC_URL=https://sepolia.drpc.org
PRIVATE_KEY=REEMPLAZAR_SIN_0X
CONTRACT_ADDRESS=0xREEMPLAZAR
